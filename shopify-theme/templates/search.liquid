<div class="container-wide section-pad">
  <p class="eyebrow" style="margin-bottom: 1rem;">Search</p>
  <h1 style="font-size: clamp(1.75rem, 4vw, 3rem); margin-bottom: 2rem;">
    {%- if search.performed -%}Results for "{{ search.terms | escape }}"{%- else -%}Find your part{%- endif -%}
  </h1>
  <form action="{{ routes.search_url }}" method="get" role="search" style="max-width: 32rem; margin-bottom: 3rem;">
    <input type="hidden" name="type" value="product">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search parts..." style="width: 100%; height: 48px; padding: 0 1rem; border-radius: 10px; background: var(--surface); border: 1px solid var(--hairline); color: var(--foreground); font-size: 15px;">
  </form>
  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color: var(--muted-foreground);">No results. Try a different search.</p>
    {%- endif -%}
  {%- endif -%}
</div>
