<div class="container-wide section-pad">
  <p class="eyebrow" style="margin-bottom: 1rem;">Shop</p>
  <h1 style="font-size: clamp(1.75rem, 4vw, 3rem); margin-bottom: 2rem;">{{ collection.title }}</h1>
  {%- if collection.description != blank -%}
    <div class="prose-product" style="max-width: 42rem; color: var(--muted-foreground); margin-bottom: 3rem;">{{ collection.description }}</div>
  {%- endif -%}
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products -%}{% render 'product-card', product: product %}{%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav style="margin-top: 3rem; display: flex; gap: 0.5rem; justify-content: center;" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- else -%}
      <p style="color: var(--muted-foreground);">No products yet.</p>
    {%- endif -%}
  {%- endpaginate -%}
</div>
