<div class="container-wide section-pad">
  <p class="eyebrow" style="margin-bottom: 1rem;">Cart</p>
  <h1 style="font-size: clamp(1.75rem, 4vw, 3rem); margin-bottom: 2rem;">Your build</h1>
  {%- if cart.item_count == 0 -%}
    <p style="color: var(--muted-foreground);">Your cart is empty.</p>
    <div style="margin-top: 2rem;"><a class="btn-primary" href="{{ routes.all_products_collection_url }}">Continue shopping</a></div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post">
      {%- for item in cart.items -%}
        <div class="cart-item">
          <div class="cart-item__img">{%- if item.image -%}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}">{%- endif -%}</div>
          <div class="cart-item__body">
            <div class="cart-item__title">{{ item.product.title }}</div>
            {%- unless item.variant.title contains 'Default' -%}<div class="cart-item__variant">{{ item.variant.title }}</div>{%- endunless -%}
            <div class="cart-item__price">{{ item.final_line_price | money }}</div>
          </div>
          <div class="cart-item__side">
            <input type="number" name="updates[]" min="0" value="{{ item.quantity }}" style="width: 60px; height: 32px; border: 1px solid var(--hairline); border-radius: 6px; background: transparent; color: var(--foreground); padding: 0 8px;">
          </div>
        </div>
      {%- endfor -%}
      <div class="hairline-t" style="margin-top: 2rem; padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
          <p class="eyebrow neutral" style="margin: 0;">Subtotal</p>
          <p style="font-size: 24px; font-weight: 700; margin: 0.25rem 0 0;">{{ cart.total_price | money }}</p>
        </div>
        <div style="display: flex; gap: 0.75rem;">
          <button type="submit" name="update" class="btn-ghost">Update</button>
          <button type="submit" name="checkout" class="btn-primary">Checkout</button>
        </div>
      </div>
    </form>
  {%- endif -%}
</div>
