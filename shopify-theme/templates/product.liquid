<div class="container-wide section-pad">
  <p class="eyebrow" style="margin-bottom: 1rem;">Product</p>
  <div class="product-layout" style="display: grid; gap: 3rem;">
    <div>
      {%- if product.featured_image -%}
        <div style="aspect-ratio: 4/3; border: 1px solid var(--hairline); border-radius: 12px; overflow: hidden;">
          {{ product.featured_image | image_url: width: 1400 | image_tag: alt: product.title, loading: 'eager' }}
        </div>
      {%- endif -%}
    </div>
    <div>
      <p class="eyebrow" style="margin-bottom: 0.75rem;">{{ product.type }}</p>
      <h1 style="font-size: clamp(1.75rem, 3vw, 2.5rem); margin-bottom: 1rem;">{{ product.title }}</h1>
      <p style="font-size: 20px; font-weight: 600; margin-bottom: 2rem;">{{ product.price | money }}</p>
      <form action="{{ routes.cart_url }}/add" method="post" enctype="multipart/form-data">
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div style="margin-bottom: 1rem;">
              <label style="display: block; font-family: var(--font-display); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.5rem;">{{ option.name }}</label>
              <select name="options[{{ option.name | escape }}]" data-option-index="{{ forloop.index0 }}" style="width: 100%; height: 44px; padding: 0 1rem; border-radius: 8px; background: var(--surface); border: 1px solid var(--hairline); color: var(--foreground); font-size: 14px;">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
        {%- endunless -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>
        <button type="submit" class="btn-primary" data-added-label="Added to Cart" style="width: 100%; margin-top: 1rem;">
          {%- if product.selected_or_first_available_variant.available -%}Add to Build{%- else -%}Sold out{%- endif -%}
        </button>
      </form>
      <div class="prose-product" style="margin-top: 2rem; color: var(--muted-foreground); font-size: 15px; line-height: 1.7;">{{ product.description }}</div>
    </div>
  </div>
</div>
<style>@media (min-width: 1024px) { .product-layout { grid-template-columns: 1.4fr 1fr; } }</style>
<script>
  (function() {
    var variants = {{ product.variants | json }};
    var form = document.querySelector('form[action$="/cart/add"]');
    if (!form) return;
    var selects = form.querySelectorAll('select[name^="options"]');
    var hidden = form.querySelector('[data-variant-id]');
    function update() {
      var chosen = Array.from(selects).map(function(s) { return s.value; });
      var match = variants.find(function(v) { return v.options.every(function(o, i) { return o === chosen[i]; }); });
      if (match) hidden.value = match.id;
    }
    selects.forEach(function(s) { s.addEventListener('change', update); });
  })();
</script>
