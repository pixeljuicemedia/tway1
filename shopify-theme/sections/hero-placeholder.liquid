<section class="hero-placeholder">
  <div>
    <p class="eyebrow" style="margin-bottom: 1rem;">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.subhead != blank -%}<p>{{ section.settings.subhead }}</p>{%- endif -%}
    {%- if section.settings.cta_link != blank -%}
      <div style="margin-top: 2rem;">
        <a href="{{ section.settings.cta_link }}" class="btn-primary">{{ section.settings.cta_label | default: 'Shop Now' }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero (placeholder)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Corvette Performance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered for the Podium" },
    { "type": "textarea", "id": "subhead", "label": "Subhead", "default": "Track-tested Corvette parts and race-shop craftsmanship - from C5 to E-Ray." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop All Parts" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "Hero (placeholder)" }]
}
{% endschema %}
